# Port the Express server listens on
API_PORT=3001

# ── Database (Prisma / Postgres) ────────────────────────────────────────────
# Direct Postgres connection string. prisma/schema.prisma's datasource reads
# this - required for the server to boot at all (users, clinic_configs,
# user_clinic_access, requests, etc. all live here).
DIRECT_DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# ── Sessions ─────────────────────────────────────────────────────────────────
# Long random string signing the login session cookie. Rotating this value
# invalidates every active session at once.
SESSION_SECRET=change-me-to-a-long-random-string

# ── n8n (production multi-clinic workflows) ─────────────────────────────────
# Base URL for the shared Inbound/Outbound/Settings/Recovery webhooks
# (handoff doc §6), e.g. https://n8n.getnapsolutions.com/webhook
N8N_BASE_URL=
# Header Auth name/value n8n's webhooks require on every request from this
# server. Must match the credential configured on those webhook nodes.
N8N_DASHBOARD_AUTH_HEADER=Authorization
N8N_DASHBOARD_AUTH_VALUE=

# Retell webhook hardening. Use Retell's designated webhook API key only on
# the server, and point these at header-authenticated replacement n8n routes.
# Never expose these values to the browser.
RETELL_WEBHOOK_API_KEY=
N8N_RETELL_CALL_ANALYZED_URL=
N8N_RETELL_INBOUND_ROUTER_URL=
N8N_RETELL_RECEPTIONIST_URL=
N8N_RETELL_OUTBOUND_CALL_ANALYZED_URL=
N8N_RETELL_OUTBOUND_CONTEXT_URL=
# Dedicated webhook for the Staff Action Queue / Appointment Requests API
# (FRONTEND-BFF-HANDOFF.md) - the only thing allowed to read/write the
# `requests` and `appointment_events` tables.
N8N_APPOINTMENT_REQUESTS_URL=https://n8n.getnapsolutions.com/webhook/rivacare-appointment-requests
# Dedicated webhook for the SMS Follow-Ups status check
# (FRONTEND-DEVELOPER-HANDOFF-SMS-ONLY.md) - a separate database-backed
# workflow, queried for status only (queueing/sending happens entirely
# inside n8n, this server never sends SMS itself).
N8N_SMS_FOLLOWUPS_URL=https://n8n.getnapsolutions.com/webhook/rivacare-sms-followups
# Dedicated webhook for the Knowledge Base Submission Queue
# (FRONTEND-DEVELOPER-HANDOFF.md) - writes queue records to Postgres but
# never receives the binary file itself; PDF/DOCX bytes stay in this
# server's private local storage (KNOWLEDGE_UPLOADS_DIR below).
N8N_KNOWLEDGE_BASE_SUBMISSIONS_URL=https://n8n.getnapsolutions.com/webhook/rivacare-knowledge-base-submissions
# Dedicated webhook for Outbound Batch Calls (FRONTEND-DEVELOPER-HANDOFF (1).md)
# - create-then-dispatch batch calling, replacing the old single-shot
# outbound/make-call route (retired).
N8N_OUTBOUND_BATCHES_URL=https://n8n.getnapsolutions.com/webhook/rivacare-outbound-batches

# ── Multi-clinic Manager Assistant demo ─────────────────────────────────────
# Server-side only. Never prefix these with VITE_ and never expose either
# value to the browser. If either value is blank, the demo remains usable for
# its supported metric questions through a deterministic fallback, clearly
# reported as mode=deterministic_demo rather than pretending an LLM answered.
OPENAI_API_KEY=
MANAGER_ASSISTANT_MODEL=gpt-5.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 32 random bytes, encoded as base64 or 64 hex characters. Generate once,
# store only in the server secret manager, and back it up securely. Rotating
# requires a documented re-encryption operation; changing it directly makes
# existing Advisor messages unreadable.
ADVISOR_ENCRYPTION_KEY=
ADVISOR_ENCRYPTION_KEY_VERSION=v1
# During rotation, provide every still-readable version as a server-only JSON
# map (for example {"v1":"<old>","v2":"<new>"}), set VERSION=v2 and
# ADVISOR_ENCRYPTION_KEY to the v2 key, then run the documented re-encryption.
ADVISOR_ENCRYPTION_KEYS=
# Retrieval accepts only close, scope-authorized vector matches. Keep these
# server-side values conservative; lower distance means a stronger match.
ADVISOR_MEMORY_DISTANCE_THRESHOLD=0.55
ADVISOR_MEMORY_DEDUPE_DISTANCE=0.12
N8N_MANAGER_INSIGHTS_URL=https://n8n.example.com/webhook/rivacare-manager-insights
N8N_MANAGER_ANALYST_TOOLS_URL=https://n8n.example.com/webhook/rivacare-manager-analyst-tools

# Directory PDF/DOCX knowledge-base submissions are written to. Deliberately
# NOT served statically - files are addressed only by an opaque storage_key,
# never a public URL. Defaults to ./data/knowledge-uploads.
KNOWLEDGE_UPLOADS_DIR=./data/knowledge-uploads

# Secret key n8n must send in the x-dashboard-api-key header when calling
# GET /api/settings-by-client/:clientId (server/index.js) - the one
# server-to-server settings read the "Juvonno Settings Backend" workflow
# still uses directly. The rest of the legacy /api/link/:accessToken/*
# surface this key used to also guard is fully retired (410 only).
DASHBOARD_API_KEY=change-me-to-a-strong-secret

# Path to the JSON settings file GET /api/settings-by-client/:clientId reads
# from (relative to the project root).
SETTINGS_FILE=./data/settings.json

# Frontend env vars (used at Vite build time — prefix with VITE_)
VITE_ENABLE_WEBHOOKS=true
VITE_API_BASE_URL=

# Local dashboard only: skips browser sign-in, does not require database
# credentials, and only permits this fixed demo scope. Never set in production.
LOCAL_DASHBOARD_NO_LOGIN=true
LOCAL_DASHBOARD_USERNAME=test_clinic
LOCAL_DASHBOARD_USER_ID=local_demo
LOCAL_DASHBOARD_TENANT_ID=clinic_001
LOCAL_DASHBOARD_CLINIC_ID=clinic_001
LOCAL_DASHBOARD_CLINIC_NAME=Local demo clinic
