# Port the Express server listens on
API_PORT=3001

# ── Database (Prisma / Postgres) ────────────────────────────────────────────
# Direct Postgres connection string. prisma/schema.prisma's datasource reads
# this - required for the server to boot at all (users, clinic_configs,
# user_clinic_access, requests, etc. all live here).
DIRECT_DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# ── Sessions ─────────────────────────────────────────────────────────────────
# Long random string signing the login session cookie. Rotating this value
# invalidates every active session at once.
SESSION_SECRET=change-me-to-a-long-random-string

# ── n8n (production multi-clinic workflows) ─────────────────────────────────
# Base URL for the shared Inbound/Outbound/Settings/Recovery webhooks
# (handoff doc §6), e.g. https://n8n.getnapsolutions.com/webhook
N8N_BASE_URL=
# Header Auth name/value n8n's webhooks require on every request from this
# server. Must match the credential configured on those webhook nodes.
N8N_DASHBOARD_AUTH_HEADER=Authorization
N8N_DASHBOARD_AUTH_VALUE=
# Dedicated webhook for the Staff Action Queue / Appointment Requests API
# (FRONTEND-BFF-HANDOFF.md) - the only thing allowed to read/write the
# `requests` and `appointment_events` tables.
N8N_APPOINTMENT_REQUESTS_URL=https://n8n.getnapsolutions.com/webhook/rivacare-appointment-requests

# Secret key n8n must send in the x-dashboard-api-key header when pushing data
# to the legacy MVP endpoints (retired - see server/index.js's /api/link 410).
DASHBOARD_API_KEY=change-me-to-a-strong-secret

# Paths to the legacy JSON data files (relative to the project root) - no
# longer read as production state, kept only for local/offline dev fallback.
TENANT_LINKS_FILE=./data/tenant-links.json
REQUESTS_DATA_FILE=./data/requests.json
SETTINGS_FILE=./data/settings.json

# Frontend env vars (used at Vite build time — prefix with VITE_)
VITE_ENABLE_WEBHOOKS=true
VITE_API_BASE_URL=
