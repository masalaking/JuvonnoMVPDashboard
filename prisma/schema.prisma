  updated_at                  DateTime       @default(now()) @db.Timestamptz(6)
  id                          BigInt         @id @default(autoincrement())
  clinic_configs              clinic_configs @relation(fields: [tenant_id, clinic_id], references: [tenant_id, clinic_id], onDelete: Cascade, onUpdate: NoAction, map: "payment_recovery_clinics_tenant_clinic_fk")
  tenants                     tenants        @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, clinic_id])
}

model payment_recovery_communications {
  id               BigInt         @id @default(autoincrement())
  tenant_id        String
  clinic_id        String
  communication_id String
  task_id          String?
  queue_id         String?
  invoice_id       String?
  channel          String?
  direction        String?
  recipient        String?
  message          String?
