generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_DATABASE_URL")
}

model billing_months {
  id                  BigInt         @id @default(autoincrement())
  tenant_id           String
  billing_month       String         @db.Char(7)
  billing_key         String         @unique
  cumulative_minutes  Decimal        @default(0) @db.Decimal(12, 2)
  total_calls         Int            @default(0)
  total_recordings    Int            @default(0)
  total_transcripts   Int            @default(0)
  included_minutes    Decimal        @default(1000) @db.Decimal(12, 2)
  base_rate           Decimal        @default(500) @db.Decimal(12, 2)
  client_rate_per_min Decimal        @default(0.50) @db.Decimal(12, 4)
  overage_rate        Decimal        @default(0.70) @db.Decimal(12, 4)
  last_notified_at    Decimal        @default(0) @db.Decimal(12, 2)
  overage_alert_sent  Boolean        @default(false)
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime       @default(now()) @db.Timestamptz(6)
  clinic_id           String
  clinic_configs      clinic_configs @relation(fields: [tenant_id, clinic_id], references: [tenant_id, clinic_id], onDelete: Cascade, onUpdate: NoAction, map: "billing_months_tenant_clinic_fk")
  tenants             tenants        @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, clinic_id, billing_month], map: "billing_months_tenant_clinic_month_uidx")
  @@index([tenant_id, billing_month(sort: Desc)], map: "billing_months_tenant_month_idx")
}

model calls {
  id                BigInt         @id @default(autoincrement())
  tenant_id         String
  retell_call_id    String
  call_key          String         @unique
  retell_agent_id   String?
  from_number       String?
  call_status       String?
  disconnect_reason String?
  started_at        DateTime?      @db.Timestamptz(6)
  duration_seconds  Int            @default(0)
  duration_minutes  Decimal        @default(0) @db.Decimal(12, 2)
  summary           String?
  sentiment         String?
  transcript        String?
  recording_url     String?
  metadata          Json           @default("{}")
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  updated_at        DateTime       @default(now()) @db.Timestamptz(6)
  clinic_id         String
  to_number         String?
  clinic_configs    clinic_configs @relation(fields: [tenant_id, clinic_id], references: [tenant_id, clinic_id], onDelete: NoAction, onUpdate: NoAction, map: "calls_tenant_clinic_fk")
  tenants           tenants        @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, retell_call_id])
  @@index([tenant_id, clinic_id, started_at(sort: Desc)], map: "calls_tenant_clinic_started_idx")
  @@index([tenant_id, started_at(sort: Desc)], map: "calls_tenant_started_at_idx")
  @@index([tenant_id, call_status], map: "calls_tenant_status_idx")
}

model clinic_configs {
  tenant_id                        String
  client_id                        String
  clinic_id                        String
  juvonno_base_url                 String?
  juvonno_credential_ref           String?
  retell_agent_id                  String?
  retell_phone_number              String?                           @unique
  retell_credential_ref            String?
  default_branch_code              String?
  included_minutes                 Decimal                           @default(1000) @db.Decimal(12, 2)
  base_rate                        Decimal                           @default(500) @db.Decimal(12, 2)
  client_rate_per_min              Decimal                           @default(0.50) @db.Decimal(12, 4)
  overage_rate                     Decimal                           @default(0.70) @db.Decimal(12, 4)
  settings                         Json                              @default("{}")
  created_at                       DateTime                          @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime                          @default(now()) @db.Timestamptz(6)
  id                               BigInt                            @id @default(autoincrement())
  clinic_name                      String?
  status                           String                            @default("active")
  timezone                         String?
  clinic_phone                     String?
  clinic_email                     String?
  payment_portal_url               String?
  juvonno_auth_style               String                            @default("header")
  juvonno_api_key_encrypted        Bytes?
  retell_receptionist_agent_id     String?
  retell_receptionist_phone_number String?
  retell_outbound_agent_id         String?
  retell_outbound_phone_number     String?
  retell_recovery_agent_id         String?
  retell_recovery_phone_number     String?
  appointment_events               appointment_events[]
  billing_months                   billing_months[]
  booking_slot_locks               booking_slot_locks[]
  calls                            calls[]
  tenants                          tenants                           @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  clinic_settings                  clinic_settings[]
  invoices                         invoices[]
  outbound_billing_months          outbound_billing_months[]
  outbound_calls                   outbound_calls[]
  outbound_invoices                outbound_invoices[]
  payment_recovery_call_queue      payment_recovery_call_queue[]
  payment_recovery_clinics         payment_recovery_clinics?
  payment_recovery_communications  payment_recovery_communications[]
  payment_recovery_followup_tasks  payment_recovery_followup_tasks[]
  payment_recovery_invoices        payment_recovery_invoices[]
  payment_recovery_metrics         payment_recovery_metrics[]
  requests                         requests[]
  user_clinic_access               user_clinic_access[]
  webhook_events                   webhook_events[]

  @@unique([tenant_id, clinic_id], map: "clinic_configs_tenant_clinic_uidx")
  @@index([tenant_id, status, clinic_id], map: "clinic_configs_tenant_status_idx")
}

model clinic_settings {
  id             BigInt         @id @default(autoincrement())
  tenant_id      String
  clinic_id      String
  section        String
  data           Json           @default("{}")
  version        Int            @default(1)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime       @default(now()) @db.Timestamptz(6)
  clinic_configs clinic_configs @relation(fields: [tenant_id, clinic_id], references: [tenant_id, clinic_id], onDelete: Cascade, onUpdate: NoAction)
  tenants        tenants        @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, clinic_id, section])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model invoices {
  id              BigInt         @id @default(autoincrement())
  tenant_id       String
  invoice_id      String
  billing_month   String         @db.Char(7)
  status          String         @default("pending")
  base_amount     Decimal        @default(0) @db.Decimal(12, 2)
  overage_minutes Decimal        @default(0) @db.Decimal(12, 2)
  overage_amount  Decimal        @default(0) @db.Decimal(12, 2)
  total_amount    Decimal        @default(0) @db.Decimal(12, 2)
  generated_at    DateTime       @default(now()) @db.Timestamptz(6)
  due_at          DateTime?      @db.Timestamptz(6)
  paid_at         DateTime?      @db.Timestamptz(6)
  details         Json           @default("{}")
  clinic_id       String
  clinic_configs  clinic_configs @relation(fields: [tenant_id, clinic_id], references: [tenant_id, clinic_id], onDelete: Cascade, onUpdate: NoAction, map: "invoices_tenant_clinic_fk")
  tenants         tenants        @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, clinic_id, billing_month], map: "invoices_tenant_clinic_month_uidx")
  @@index([tenant_id, billing_month(sort: Desc)], map: "invoices_tenant_month_idx")
}

model outbound_billing_months {
  id                  BigInt         @id @default(autoincrement())
  tenant_id           String
  billing_month       String         @db.Char(7)
  billing_key         String         @unique
  cumulative_minutes  Decimal        @default(0) @db.Decimal(12, 2)
  total_calls         Int            @default(0)
  total_recordings    Int            @default(0)
  total_transcripts   Int            @default(0)
  included_minutes    Decimal        @default(1000) @db.Decimal(12, 2)
  base_rate           Decimal        @default(500) @db.Decimal(12, 2)
  client_rate_per_min Decimal        @default(0.50) @db.Decimal(12, 4)
  overage_rate        Decimal        @default(0.70) @db.Decimal(12, 4)
  last_notified_at    Decimal        @default(0) @db.Decimal(12, 2)
  overage_alert_sent  Boolean        @default(false)
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime       @default(now()) @db.Timestamptz(6)
  clinic_id           String
  clinic_configs      clinic_configs @relation(fields: [tenant_id, clinic_id], references: [tenant_id, clinic_id], onDelete: Cascade, onUpdate: NoAction, map: "outbound_billing_months_tenant_clinic_fk")
  tenants             tenants        @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, clinic_id, billing_month], map: "outbound_billing_months_tenant_clinic_month_uidx")
  @@index([tenant_id, billing_month(sort: Desc)], map: "outbound_billing_tenant_month_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
