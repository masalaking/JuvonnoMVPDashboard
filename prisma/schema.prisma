model requests {
  id                     String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenant_id              String
  status                 String               @default("pending")
  data                   Json                 @default("{}")
  created_at             DateTime             @default(now()) @db.Timestamptz(6)
  updated_at             DateTime             @default(now()) @db.Timestamptz(6)
  clinic_id              String
  request_type           String               @default("general")
  idempotency_key        String?
  juvonno_appointment_id String?
  patient_external_id    String?
  retell_call_id         String?
  requires_staff_action  Boolean              @default(true)
  priority               String               @default("normal")
  source                 String               @default("integration")
  assigned_user_id       String?
  resolution_code        String?
  resolution_note        String?
  resolved_at            DateTime?            @db.Timestamptz(6)
  archived_at            DateTime?            @db.Timestamptz(6)
  appointment_events     appointment_events[]
  users                  users?               @relation(fields: [assigned_user_id], references: [id], onUpdate: NoAction, map: "requests_assigned_user_fk")
  clinic_configs         clinic_configs       @relation(fields: [tenant_id, clinic_id], references: [tenant_id, clinic_id], onDelete: Cascade, onUpdate: NoAction, map: "requests_tenant_clinic_fk")
  tenants                tenants              @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenant_id, status], map: "requests_tenant_status_idx")
  @@index([tenant_id, clinic_id, juvonno_appointment_id], map: "requests_appointment_lookup_idx")
}

model rivacare_internal_secrets {
  key_name     String    @id
  secret_value String
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  rotated_at   DateTime? @db.Timestamptz(6)
}

model settings {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  tenant_id  String
  section    String
  data       Json     @default("{}")
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  tenants    tenants  @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, section])
  @@index([tenant_id])
}

