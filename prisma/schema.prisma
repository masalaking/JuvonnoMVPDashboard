  timestamp        DateTime       @default(now()) @db.Timestamptz(6)
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  updated_at       DateTime       @default(now()) @db.Timestamptz(6)
  clinic_configs   clinic_configs @relation(fields: [tenant_id, clinic_id], references: [tenant_id, clinic_id], onDelete: Cascade, onUpdate: NoAction, map: "payment_recovery_communications_tenant_clinic_fk")

  @@unique([tenant_id, clinic_id, communication_id], map: "payment_recovery_communication_scope_uidx")
