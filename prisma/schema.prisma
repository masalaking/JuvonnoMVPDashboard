  days_overdue                  Int            @default(0)
  recovery_stage                String         @default("new")
  manual_hold                   Boolean        @default(false)
  opt_out                       Boolean        @default(false)
  recovery_program_entry_amount Decimal        @default(0) @db.Decimal
  paid_at                       DateTime?      @db.Timestamptz(6)
  last_verified_at              DateTime?      @db.Timestamptz(6)
  last_updated                  DateTime       @default(now()) @db.Timestamptz(6)
  created_at                    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime       @default(now()) @db.Timestamptz(6)
  clinic_configs                clinic_configs @relation(fields: [tenant_id, clinic_id], references: [tenant_id, clinic_id], onDelete: Cascade, onUpdate: NoAction, map: "payment_recovery_invoices_tenant_clinic_fk")

  @@unique([tenant_id, clinic_id, invoice_id], map: "payment_recovery_invoice_scope_uidx")
}

model payment_recovery_metrics {
  id                             BigInt         @id @default(autoincrement())
  tenant_id                      String
  clinic_id                      String
  metric_date                    DateTime       @db.Date
  total_outstanding              Decimal        @default(0) @db.Decimal
  eligible_overdue               Decimal        @default(0) @db.Decimal
  recovered_revenue              Decimal        @default(0) @db.Decimal
  recovered_invoices             Int            @default(0)
  automated_contacts             Int            @default(0)
  calls_attempted                Int            @default(0)
  calls_answered                 Int            @default(0)
  staff_hours_saved              Decimal        @default(0) @db.Decimal
  labour_savings                 Decimal        @default(0) @db.Decimal
  automation_cost                Decimal        @default(0) @db.Decimal
  estimated_incremental_recovery Decimal        @default(0) @db.Decimal
  estimated_total_savings        Decimal        @default(0) @db.Decimal
  roi_percent                    Decimal?       @db.Decimal
  last_updated                   DateTime       @default(now()) @db.Timestamptz(6)
  created_at                     DateTime       @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime       @default(now()) @db.Timestamptz(6)
  clinic_configs                 clinic_configs @relation(fields: [tenant_id, clinic_id], references: [tenant_id, clinic_id], onDelete: Cascade, onUpdate: NoAction, map: "payment_recovery_metrics_tenant_clinic_fk")

  @@unique([tenant_id, clinic_id, metric_date])
