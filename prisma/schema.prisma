  clinic_phone                String?
  billing_from_email          String?
  payment_portal_url          String?
  enable_sms                  Boolean        @default(false)
  enable_email                Boolean        @default(true)
  timezone                    String         @default("America/Toronto")
  juvonno_api_key             String?
  enable_ai_calls             Boolean        @default(false)
  retell_from_number          String?
  retell_agent_id             String?
  call_day_7_enabled          Boolean        @default(true)
  call_day_14_enabled         Boolean        @default(true)
  day_14_minimum_balance      Decimal        @default(0) @db.Decimal(12, 2)
