  tenants         tenants        @relation(fields: [tenant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenant_id, clinic_id, billing_month], map: "outbound_invoices_tenant_clinic_month_uidx")
  @@index([tenant_id, billing_month(sort: Desc)], map: "outbound_invoices_tenant_month_idx")
