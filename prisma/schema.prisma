  invoice_ids       String?
  invoice_numbers   String?
  amount_due        Decimal        @default(0) @db.Decimal
  due_date          DateTime?      @db.Date
  days_overdue      Int            @default(0)
  call_stage        String?
  scheduled_for     DateTime?      @db.Timestamptz(6)
  approval_status   String         @default("pending")
