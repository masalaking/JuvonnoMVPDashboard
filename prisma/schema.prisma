  @@index([tenant_id, clinic_id, started_at(sort: Desc)], map: "outbound_calls_tenant_clinic_started_at_idx")
  @@index([tenant_id, started_at(sort: Desc)], map: "outbound_calls_tenant_started_at_idx")
