  @@unique([tenant_id, clinic_id, task_id], map: "payment_recovery_task_scope_uidx")
}

model payment_recovery_invoices {
  id                            BigInt         @id @default(autoincrement())
  tenant_id                     String
  clinic_id                     String
  invoice_id                    String
  invoice_number                String?
  customer_id                   String?
  patient_name                  String?
  patient_phone                 String?
  patient_email                 String?
